{
  "name": "nexushr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "api": "npm --workspace backend run api",
    "api:watch": "npm --workspace backend run api:watch",
    "db:seed": "npm --workspace backend run db:seed",
    "build": "npm --workspace frontend run build",
    "preview": "npm --workspace frontend run preview"
  }
}
